{
  "name": "hostamble",
  "version": "0.1.0",
  "private": true,
  "description": "HostAmble - Independent, high-performance web hosting and domain services frontend",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "deploy": "wrangler deploy",
    "preview:worker": "astro build && wrangler dev"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^5.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "eslint": "^9.20.0",
    "eslint-plugin-astro": "^1.3.1",
    "prettier": "^3.5.0",
    "prettier-plugin-astro": "^0.14.1",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.7",
    "wrangler": "^4.152.0"
  }
}
