  import type { CurrencyCode } from '../lib/currency/types';
  import type { BillingPeriod } from '../lib/pricing/types';

  let currentPeriod: BillingPeriod = 'annual';

  function updateAllPlanCards(targetCurrency: CurrencyCode, targetPeriod: BillingPeriod) {
    const cards = document.querySelectorAll<HTMLElement>('[data-plan-card]');

    cards.forEach((card) => {
      const planId = card.getAttribute('data-plan-card');
      const matrixRaw = card.getAttribute('data-plan-matrix');
      if (!planId || !matrixRaw) return;

      try {
        const matrix = JSON.parse(matrixRaw);
        const curData = matrix[targetCurrency];
        const periodData = curData ? curData[targetPeriod] : undefined;

        const priceEl = card.querySelector<HTMLElement>(`[data-display-price="${planId}"]`);
        const termsEl = card.querySelector<HTMLElement>(`[data-display-terms="${planId}"]`);

        if (priceEl && periodData) {
          if (periodData.isAvailable) {
            priceEl.textContent = periodData.formattedMonthlyEquivalent;
            if (termsEl) {
              if (targetPeriod === 'annual') {
                termsEl.textContent = `Billed annually (${periodData.formattedTotal}/yr)`;
              } else if (targetPeriod === 'quarterly') {
                termsEl.textContent = `Billed quarterly (${periodData.formattedTotal}/quarter)`;
              } else if (targetPeriod === 'semiannual') {
                termsEl.textContent = `Billed every 6 months (${periodData.formattedTotal})`;
              } else {
                termsEl.textContent = 'Billed monthly (renews at same rate)';
              }
            }
          } else {
            priceEl.textContent = 'Unavailable';
            if (termsEl) termsEl.textContent = 'Not supported for this cycle';
          }
        }
      } catch {
        // Safe parsing
      }
    });

    // Also update domain TLD prices
    const tldPrices: Record<CurrencyCode, Record<string, string>> = {
      INR: { in: '₹399/yr', com: '₹799/yr', io: '₹2,699/yr' },
      USD: { in: '$4.99/yr', com: '$9.99/yr', io: '$32.99/yr' },
      EUR: { in: '€4.49/yr', com: '€8.99/yr', io: '€29.99/yr' },
    };

    const currencyTlds = tldPrices[targetCurrency] || tldPrices.USD;
    document.querySelectorAll<HTMLElement>('[data-tld-price]').forEach((el) => {
      const tld = el.getAttribute('data-tld-price');
      if (tld && currencyTlds[tld]) {
        el.textContent = currencyTlds[tld]!;
      }
    });
  }

  function initInteractivePricing() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.billing-tab');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const period = tab.getAttribute('data-billing-tab') as BillingPeriod;
        if (!period) return;
        currentPeriod = period;

        tabs.forEach((t) => {
          t.classList.remove(
            'active',
            'bg-[#FFB800]',
            'text-[#15130F]',
            'shadow-sm',
            'font-bold'
          );
          t.classList.add('text-[#605A50]', 'font-medium');
        });
        tab.classList.add(
          'active',
          'bg-[#FFB800]',
          'text-[#15130F]',
          'shadow-sm',
          'font-bold'
        );
        tab.classList.remove('text-[#605A50]');

        const currentCurrency = getSavedCurrencyPreference().currency;
        updateAllPlanCards(currentCurrency, currentPeriod);
      });
    });

    const pref = getSavedCurrencyPreference();
    updateAllPlanCards(pref.currency, currentPeriod);

    window.addEventListener(CURRENCY_CHANGE_EVENT, (e: Event) => {
      const customEvent = e as CustomEvent<{ currency: CurrencyCode }>;
      const curr = customEvent.detail?.currency;
      if (curr) {
        updateAllPlanCards(curr, currentPeriod);
      }
    });
  }

  function initDomainSearch() {
    const form = document.getElementById('domain-search-form');
    const msg = document.getElementById('domain-status-msg');
    const closeBtn = document.getElementById('domain-status-close');

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      msg?.classList.remove('hidden');
    });

    closeBtn?.addEventListener('click', () => {
      msg?.classList.add('hidden');
    });
  }

  function initPage() {
    initInteractivePricing();
    initDomainSearch();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPage);
  } else {
    initPage();
  }
  document.addEventListener('astro:page-load', initPage);
</script>
