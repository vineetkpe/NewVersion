---
import type { Product, BillingPeriod } from '../../lib/pricing/types';
import PriceDisplay from './PriceDisplay.astro';
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';

interface Props {
  readonly product: Product;
  readonly defaultPeriod?: BillingPeriod;
  readonly ctaHref?: string;
  readonly ctaText?: string;
  readonly class?: string;
}

const {
  product,
  defaultPeriod = 'monthly',
  ctaHref = `/hosting/${product.category}`,
  ctaText = 'Configure Plan',
  class: className = '',
} = Astro.props;

const isFeatured = product.isFeatured;
---

<div
  class:list={[
    'relative flex flex-col justify-between p-6 sm:p-8 bg-white rounded border transition-all duration-200',
    isFeatured
      ? 'border-brand-primary ring-1 ring-brand-primary shadow-elevated'
      : 'border-surface-border hover:border-brand-muted shadow-card',
    className,
  ]}
>
  <div>
    <!-- Top Meta -->
    <div class="flex items-center justify-between gap-3 mb-4">
      <span class="text-xs font-mono uppercase tracking-wider text-text-muted">
        {product.category}
      </span>
      {
        product.badge && (
          <Badge variant={isFeatured ? 'brand' : 'neutral'} size="sm">
            {product.badge}
          </Badge>
        )
      }
    </div>

    <!-- Title & Tagline -->
    <h3 class="text-xl font-bold text-text-dark tracking-tight mb-2">
      {product.name}
    </h3>
    <p class="text-sm text-text-secondary leading-relaxed mb-6">
      {product.tagline}
    </p>

    <!-- Pricing Section -->
    <div class="py-4 border-y border-surface-border/60 mb-6">
      <PriceDisplay product={product} period={defaultPeriod} />
      <p class="text-xs text-text-secondary mt-1">
        Billed {defaultPeriod === 'annual' ? 'annually' : 'monthly'}. No hidden fees.
      </p>
    </div>

    <!-- Feature List -->
    <div class="space-y-3 mb-8">
      <p class="text-xs font-semibold text-text-dark uppercase tracking-wider">
        Architecture Highlights
      </p>
      <ul class="space-y-2.5 text-sm text-text-secondary">
        {
          product.features.map((feature) => (
            <li class="flex items-start gap-2.5">
              <svg
                class="w-4 h-4 text-brand-primary mt-0.5 flex-shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2.5"
                  d="M5 13l4 4L19 7"
                />
              </svg>
              <span class="leading-tight text-text-dark/90">{feature}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <!-- Bottom CTA -->
  <div class="mt-auto pt-2">
    <Button
      href={ctaHref}
      variant={isFeatured ? 'primary' : 'outline'}
      size="md"
      class="w-full"
    >
      {ctaText}
    </Button>
  </div>
</div>
