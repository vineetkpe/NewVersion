---
interface Props {
  readonly variant?: 'info' | 'warning' | 'error' | 'success';
  readonly title?: string;
  readonly class?: string;
}

const { variant = 'info', title, class: className = '' } = Astro.props;

const variantStyles = {
  info: 'bg-brand-lavender/60 border-brand-pale text-text-dark',
  warning: 'bg-[#FFFBEB] border-[#FDE68A] text-[#92400E]',
  error: 'bg-[#FEF2F2] border-[#FECACA] text-[#991B1B]',
  success: 'bg-[#F0FDF4] border-[#BBF7D0] text-[#065F46]',
};
---

<div
  role="alert"
  class:list={[
    'p-4 rounded border text-sm leading-relaxed',
    variantStyles[variant],
    className,
  ]}
>
  {title && <h4 class="font-semibold mb-1 text-inherit">{title}</h4>}
  <div class="text-inherit opacity-90">
    <slot />
  </div>
</div>
